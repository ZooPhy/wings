from pathlib import Path
import csv

HERE = Path(workflow.basedir).resolve()
REPO_ROOT = HERE.parents[1]
WORK = HERE / "work"
PROJECT = WORK / "irma" / "project"
SEGMENT_SEQUENCE = ("HA", "NA", "PB2", "PB1", "PA", "NP", "MP", "NS")


rule build_valid_bam_fixtures:
    output:
        stamp=WORK / "irma" / "valid_bams.done"
    params:
        project=str(PROJECT)
    conda:
        "../../envs/pysam.yaml"
    script:
        "build_valid_bams.py"


checkpoint normalize_irma_outputs:
    input:
        project=PROJECT,
        prepared=WORK / "irma" / "valid_bams.done",
        normalizer=str(REPO_ROOT / "scripts" / "normalize_irma_outputs.py")
    output:
        segments=directory(WORK / "irma" / "segments"),
        manifest=WORK / "irma" / "manifest.tsv"
    log:
        WORK / "irma" / "normalize.log"
    params:
        sample="checkpoint_smoke"
    conda:
        "../../envs/pysam.yaml"
    script:
        "../../scripts/run_normalize_irma_checkpoint.py"

def normalized_manifest(_wildcards):
    return str(
        checkpoints.normalize_irma_outputs.get().output.manifest
    )


def normalized_segments_dir(_wildcards):
    return Path(
        str(checkpoints.normalize_irma_outputs.get().output.segments)
    )


def ready_segment_files(wildcards):
    manifest = Path(normalized_manifest(wildcards))
    segments_dir = normalized_segments_dir(wildcards)

    with manifest.open(encoding="utf-8") as handle:
        rows = list(csv.DictReader(handle, delimiter="\t"))

    files = []
    for row in rows:
        segment = row.get("segment", "")
        if row.get("status") != "READY":
            continue
        if segment not in SEGMENT_SEQUENCE:
            continue

        fasta = segments_dir / segment / "consensus.fasta"
        bam = segments_dir / segment / "alignment.bam"
        if fasta.is_file() and fasta.stat().st_size > 0 and bam.is_file() and bam.stat().st_size > 0:
            files.extend([str(fasta), str(bam)])

    return files


rule checkpoint_downstream:
    input:
        manifest=normalized_manifest,
        ready_files=ready_segment_files
    output:
        tsv=WORK / "downstream" / "ready_segments.tsv"
    run:
        manifest_path = Path(str(input.manifest))
        with manifest_path.open(encoding="utf-8") as handle:
            rows = list(csv.DictReader(handle, delimiter="\t"))

        ready = [
            row["segment"]
            for row in rows
            if row.get("status") == "READY"
        ]

        output_path = Path(str(output.tsv))
        output_path.parent.mkdir(parents=True, exist_ok=True)
        output_path.write_text(
            "segment\n" + "\n".join(ready) + ("\n" if ready else ""),
            encoding="utf-8",
        )


rule all:
    input:
        WORK / "downstream" / "ready_segments.tsv"
